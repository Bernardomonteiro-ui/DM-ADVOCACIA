---
import { link } from '@/utils/paths';
import '@/styles/global.css';
import serifFont from '@fontsource-variable/besley/files/besley-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import SEO, { type SEOProps } from '@/components/layout/SEO.astro';
import Header from '@/components/navigation/Header.astro';
import Footer from '@/components/layout/Footer.astro';

type Props = SEOProps;
const props = Astro.props;

const speculationRules = {
  prerender: [
    {
      where: { and: [{ href_matches: link('/') + '*' }, { not: { selector_matches: '[target=_blank]' } }] },
      eagerness: 'conservative',
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <link rel="sitemap" href={link('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0f1e33" />
    <meta name="format-detection" content="telephone=no" />
    <SEO {...props} />
    <!--
      Navegação instantânea (Chromium): pré-renderiza a página interna quando o visitante
      toca ou clica no link (eagerness "conservative": "moderate" pré-renderizava links visíveis no mobile durante o carregamento e piorava o FCP da Home). Navegadores sem suporte ignoram.
    -->
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script>
      // Revelação discreta ao entrar na viewport.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');

      // Numera as linhas dos títulos para a entrada em sequência.
      document.querySelectorAll<HTMLElement>('[data-reveal="lines"]').forEach((t) =>
        t.querySelectorAll<HTMLElement>('.ln > span').forEach((s, i) => s.style.setProperty('--i', String(i))),
      );

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        // Elementos com clip-path totalmente fechado não são detectados pelo IntersectionObserver
        // (área visível zero). Para eles, observa-se o elemento pai.
        const targets = new Map<Element, HTMLElement>();
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (targets.get(e.target) ?? e.target).classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => {
          const observed = el.dataset.reveal === 'clip' && el.parentElement ? el.parentElement : el;
          targets.set(observed, el);
          io.observe(observed);
        });
      }
    </script>

    <style is:global>
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 100;
        padding: 0.75rem 1.1rem;
        background: var(--color-navy-900);
        color: var(--color-paper);
        font-size: 0.875rem;
        transform: translateY(-200%);
        transition: transform 0.3s;
      }
      .skip-link:focus {
        transform: none;
      }
    </style>
  </body>
</html>
