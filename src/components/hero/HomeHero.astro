---
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import WhatsAppButton from '@/components/whatsapp/WhatsAppButton.astro';
import { siteConfig, whatsappMessages } from '@/config/site';
import photo from '@/assets/fotos/deivid-marcolino-bracos-cruzados.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__h1">
        <span class="eyebrow hero__eyebrow" data-reveal style="--d:1">
          <span class="hero__eyebrow-rule" aria-hidden="true"></span>
          Escritório de advocacia em Porto Alegre
        </span>
        <span class="display hero__title" data-reveal="lines" style="--d:2">
        <span class="ln"><span>Especialistas</span></span>
        <span class="ln"><span>em cada causa.</span></span>
        <span class="ln hero__title-em"><span><em>Soluções em</em></span></span>
        <span class="ln hero__title-em"><span><em>cada caso.</em></span></span>
        </span>
      </h1>

      <p class="lead hero__lead" data-reveal style="--d:7">
        Na DM Advocacia, cada cliente é atendido por um profissional especializado na área do seu caso — com escuta
        atenta, clareza e estratégia.
      </p>

      <div class="hero__ctas" data-reveal style="--d:8">
        <WhatsAppButton message={whatsappMessages.general} label="Falar com a advocacia" track="hero-whatsapp" />
        <Button href="/areas-de-atuacao" variant="text">Conhecer áreas de atuação</Button>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="hero__frame" data-reveal="clip" style="--d:3">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[420, 640, 860, 1090]}
          sizes="(min-width: 64rem) 38vw, 92vw"
          alt={`${siteConfig.lawyer.name}, advogado e fundador da DM Advocacia, de terno escuro e braços cruzados`}
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
      <figcaption class="hero__caption" data-reveal style="--d:9">
        <span class="hero__caption-name">{siteConfig.lawyer.name}</span>
        <span>Advogado e fundador</span>
      </figcaption>
    </figure>
  </div>

  <div class="wrap">
    <div class="hero__meta" data-reveal style="--d:10">
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <p>{siteConfig.address.city} <span aria-hidden="true">•</span> Atendimento em todo o Brasil</p>
      <p>{siteConfig.lawyer.oab}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(2.5rem, 6vw, 4.5rem));
    padding-bottom: clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(120% 70% at 100% 0%, rgb(13 26 43 / 0.045), transparent 60%),
      var(--color-paper);
    overflow: clip;
  }
  /* Grande bloco navy atrás da foto — profundidade sem decoração gratuita */
  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: min(31vw, 30rem);
    height: 78%;
    background: var(--color-navy-900);
    display: none;
  }
  @media (min-width: 64rem) {
    .hero::before {
      display: block;
    }
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: clamp(2rem, 4vw, 5rem);
      min-height: min(calc(100svh - var(--header-h) - 9rem), 46rem);
    }
  }

  .hero__h1 {
    margin: 0;
  }
  .hero__eyebrow {
    display: flex;
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.005em;
    align-items: center;
    gap: 1rem;
    color: var(--color-gold-ink);
  }
  .hero__eyebrow-rule {
    width: 2.5rem;
    height: 1px;
    background: var(--color-gold);
  }
  .hero__title {
    display: block;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-navy-900);
  }
  .hero__title-em {
    color: var(--color-navy-700);
    font-variation-settings: 'opsz' 72;
  }
  .hero__title-em em {
    font-weight: 300;
  }
  .hero__lead {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 32rem;
    color: var(--color-muted);
  }
  .hero__ctas {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  /* Foto */
  .hero__figure {
    position: relative;
    margin: 0;
  }
  .hero__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #2a2b2e;
  }
  @media (min-width: 64rem) {
    .hero__frame {
      aspect-ratio: 4 / 5;
      max-height: calc(100svh - var(--header-h) - 8rem);
      margin-left: auto;
    }
  }
  .hero__frame :global(img),
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  /* Leve tom navy sobre o fundo cinza da foto de estúdio */
  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(13 26 43 / 0) 55%, rgb(13 26 43 / 0.55) 100%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .hero__caption {
    position: absolute;
    left: 1.25rem;
    bottom: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--color-paper);
    font-size: 0.875rem;
    letter-spacing: 0;
  }
  .hero__caption-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    letter-spacing: 0;
    text-transform: none;
  }

  /* Rodapé do hero */
  .hero__meta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.1rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .hero__meta-rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: rgb(13 26 43 / 0.14);
  }
  .hero__meta span[aria-hidden] {
    color: var(--color-gold);
    margin-inline: 0.4rem;
  }
</style>
