---
/**
 * Hero da Home: fotografia como fundo, dissolvida no navy por gradiente.
 * Desktop: foto ocupa a direita, texto sobre o navy à esquerda.
 * Mobile: foto no topo, gradiente para o navy onde o texto começa.
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import WhatsAppButton from '@/components/whatsapp/WhatsAppButton.astro';
import { siteConfig, whatsappMessages } from '@/config/site';
import photo from '@/assets/fotos/deivid-marcolino-perfil.jpg';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={photo}
      formats={['avif', 'webp']}
      widths={[480, 800, 1100, 1299]}
      sizes="(min-width: 64rem) 64vw, 100vw"
      alt={`${siteConfig.lawyer.name}, advogado e fundador da DM Advocacia, de terno escuro`}
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__h1">
        <span class="hero__eyebrow" data-reveal style="--d:1">Escritório de advocacia em Porto Alegre</span>
        <span class="display hero__title" data-reveal="lines" style="--d:2">
          <span class="ln"><span>Especialistas</span></span>
          <span class="ln"><span>em cada causa.</span></span>
          <span class="ln hero__title-em"><span><em>Soluções em</em></span></span>
          <span class="ln hero__title-em"><span><em>cada caso.</em></span></span>
        </span>
      </h1>

      <p class="lead hero__lead" data-reveal style="--d:6">
        Na DM Advocacia, cada cliente é atendido por um profissional especializado na área do seu caso, com escuta
        atenta, clareza e estratégia.
      </p>

      <div class="hero__ctas" data-reveal style="--d:7">
        <WhatsAppButton message={whatsappMessages.general} label="Falar com a advocacia" track="hero-whatsapp" />
        <Button href="/areas-de-atuacao" variant="text-light">Conhecer áreas de atuação</Button>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="hero__meta" data-reveal style="--d:8">
      <p>{siteConfig.address.city} <span aria-hidden="true">•</span> Atendimento em todo o Brasil</p>
      <p>{siteConfig.lawyer.name}, {siteConfig.lawyer.oab}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--color-navy-950);
    color: #fff;
    overflow: clip;
    /* Mobile: espaço no topo para a foto aparecer antes do texto */
    padding-top: calc(var(--header-h) + 58vw);
    padding-bottom: 1.5rem;
  }
  @media (min-width: 64rem) {
    .hero {
      min-height: max(40rem, min(100svh, 62rem));
      justify-content: center;
      padding-top: calc(var(--header-h) + 3rem);
      padding-bottom: 2rem;
    }
  }

  /* ---------- Foto ---------- */
  .hero__media {
    position: absolute;
    z-index: -2;
    inset: 0 0 auto 0;
    height: min(118vw, 46rem);
  }
  @media (min-width: 64rem) {
    .hero__media {
      inset: 0 0 0 auto;
      width: 66%;
      height: 100%;
    }
  }
  .hero__media :global(picture),
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media :global(img) {
    object-fit: cover;
    object-position: 62% 18%;
    /* entrada discreta: aproximação lenta, sem afetar o carregamento */
    animation: hero-settle 1.8s var(--ease-out-quint) both;
  }
  @media (min-width: 64rem) {
    .hero__media :global(img) {
      object-position: 55% 22%;
    }
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.05);
    }
    to {
      transform: none;
    }
  }
  /* Aproxima o fundo cinza do estúdio do navy do site */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(10 20 36 / 0.28);
    mix-blend-mode: multiply;
  }

  /* ---------- Gradiente ---------- */
  .hero__shade {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(10 20 36 / 0.35) 0%,
      rgb(10 20 36 / 0) 16%,
      rgb(10 20 36 / 0) 30%,
      rgb(10 20 36 / 0.75) 48%,
      var(--color-navy-950) 62%
    );
  }
  @media (min-width: 64rem) {
    .hero__shade {
      background:
        linear-gradient(0deg, rgb(10 20 36 / 0.9) 0%, rgb(10 20 36 / 0) 22%),
        linear-gradient(
          90deg,
          var(--color-navy-950) 0%,
          var(--color-navy-950) 34%,
          rgb(10 20 36 / 0.88) 44%,
          rgb(10 20 36 / 0.45) 56%,
          rgb(10 20 36 / 0) 72%
        ),
        linear-gradient(180deg, rgb(10 20 36 / 0.45) 0%, rgb(10 20 36 / 0) 20%);
    }
  }

  /* ---------- Texto ---------- */
  .hero__copy {
    max-width: 38rem;
  }
  .hero__h1 {
    margin: 0;
  }
  .hero__eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    color: var(--color-gold-soft);
  }
  .hero__title {
    display: block;
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    color: #fff;
  }
  .hero__title-em {
    color: var(--color-gold-soft);
  }
  .hero__lead {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 32rem;
    color: rgb(255 255 255 / 0.78);
  }
  .hero__ctas {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  /* ---------- Rodapé do hero ---------- */
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 2rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: 1.1rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.7);
  }
  .hero__meta span[aria-hidden] {
    color: var(--color-gold-soft);
    margin-inline: 0.4rem;
  }
</style>
