---
/**
 * Botão flutuante de WhatsApp (canto inferior direito, em todas as páginas).
 * A mensagem é contextual: nas páginas de área, usa a mensagem da área.
 */
import Icon from '@/components/ui/Icon.astro';
import { whatsappLink, whatsappMessages } from '@/config/site';

interface Props {
  message?: string;
}
const { message = whatsappMessages.general } = Astro.props;
---

<a
  href={whatsappLink(message)}
  class="wa-float"
  target="_blank"
  rel="noopener"
  data-cta="whatsapp-flutuante"
  aria-label="Conversar no WhatsApp (abre em nova aba)"
>
  <span class="wa-float__label" aria-hidden="true">Fale conosco no WhatsApp</span>
  <span class="wa-float__circle" aria-hidden="true">
    <Icon name="whatsapp" size={30} />
  </span>
</a>

<style>
  .wa-float {
    position: fixed;
    z-index: 40;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 0.75rem;
    animation: wa-in 0.5s var(--ease-out-quint) 1.2s both;
  }
  @keyframes wa-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
  }
  .wa-float__circle {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--color-whatsapp);
    color: var(--color-on-accent);
    box-shadow: 0 10px 28px -8px rgb(var(--shade-rgb) / 0.45);
    transition:
      background-color var(--dur-hover) ease-out,
      transform var(--dur-hover) var(--ease-out-quint);
  }
  .wa-float:hover .wa-float__circle,
  .wa-float:focus-visible .wa-float__circle {
    background: var(--color-whatsapp-hover);
    transform: scale(1.06);
  }
  .wa-float:focus-visible {
    outline: none;
  }
  .wa-float:focus-visible .wa-float__circle {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  /* Rótulo: só no desktop, ao passar o mouse */
  .wa-float__label {
    display: none;
  }
  @media (hover: hover) and (min-width: 64rem) {
    .wa-float__label {
      display: block;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-btn);
      background: var(--color-white);
      color: var(--color-navy-950);
      font-size: 0.9rem;
      font-weight: 550;
      white-space: nowrap;
      box-shadow: 0 8px 24px -10px rgb(var(--shade-rgb) / 0.35);
      opacity: 0;
      transform: translateX(8px);
      pointer-events: none;
      transition:
        opacity var(--dur-hover) ease-out,
        transform var(--dur-hover) var(--ease-out-quint);
    }
    .wa-float:hover .wa-float__label,
    .wa-float:focus-visible .wa-float__label {
      opacity: 1;
      transform: none;
    }
  }

  /* Some enquanto o menu móvel está aberto */
  :global(html.menu-open) .wa-float {
    visibility: hidden;
  }

  @media print {
    .wa-float {
      display: none;
    }
  }
</style>
