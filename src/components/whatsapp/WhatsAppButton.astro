---
/** CTA de WhatsApp. O número vem sempre de siteConfig — nunca digitado aqui. */
import Button from '@/components/ui/Button.astro';
import { whatsappLink, whatsappMessages } from '@/config/site';

interface Props {
  message?: string;
  label?: string;
  class?: string;
  track?: string;
}
const {
  message = whatsappMessages.general,
  label = 'Falar no WhatsApp',
  class: className,
  track = 'whatsapp',
} = Astro.props;
---

<Button href={whatsappLink(message)} variant="whatsapp" icon="whatsapp" class={className} track={track}>
  {label}
</Button>
