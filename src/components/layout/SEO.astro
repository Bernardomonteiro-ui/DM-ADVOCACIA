---
import { absoluteUrl, isNoindexBuild, logicalPath } from '@/utils/paths';
import { siteConfig } from '@/config/site';

export interface SEOProps {
  title?: string;
  description?: string;
  /** Caminho absoluto da imagem OG (em /public) */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** JSON-LD já montado (usar graph() de utils/schema) */
  schema?: object;
}

const {
  title,
  description = siteConfig.seo.defaultDescription,
  image = siteConfig.seo.ogImage,
  imageAlt = `${siteConfig.name} — ${siteConfig.tagline.join(' ')}`,
  type = 'website',
  noindex = false,
  schema,
} = Astro.props as SEOProps;

const fullTitle = title ? siteConfig.seo.titleTemplate.replace('%s', title) : siteConfig.seo.defaultTitle;
// Caminho lógico (sem base e sem .html) → URL absoluta limpa.
const canonical = absoluteUrl(logicalPath(Astro.url.pathname));
const ogImage = absoluteUrl(image);
const robots = noindex || isNoindexBuild ? 'noindex, follow' : 'index, follow, max-image-preview:large';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.seo.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="geo.region" content={`BR-${siteConfig.address.state}`} />
<meta name="geo.placename" content={siteConfig.address.city} />

{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
