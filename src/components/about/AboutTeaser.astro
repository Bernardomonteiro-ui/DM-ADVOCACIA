---
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/config/site';
import { education } from '@/data/about';
import photo from '@/assets/fotos/deivid-marcolino-bracos-cruzados.jpg';
---

<section class="about section-y" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <figure class="about__figure">
      <div class="about__frame" data-reveal="clip">
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          widths={[420, 640, 900, 1090]}
          sizes="(min-width: 64rem) 48vw, 92vw"
          alt={`Retrato de ${siteConfig.lawyer.name}, advogado da DM Advocacia`}
          class="about__img"
        />
      </div>
      <figcaption class="about__oab">{siteConfig.lawyer.oab}</figcaption>
    </figure>

    <div class="about__copy">
      <h2 id="about-title" class="h-xl">{siteConfig.lawyer.name}</h2>
      <p class="about__role">Advogado e empresário, fundador da DM Advocacia</p>

      <p class="about__statement">
        Mais de {siteConfig.lawyer.yearsOfExperience} anos de experiência jurídica.
      </p>
      <p class="about__text">
        Uma formação que atravessa as áreas trabalhista, civil, criminal, digital e tributária. À frente da DM
        Advocacia, estruturou um escritório em que cada caso é conduzido por quem conhece a fundo a área.
      </p>

      <h3 class="about__edu-title">Formação</h3>
      <ul class="about__edu">
        {education.map((e) => <li>{e.title}</li>)}
      </ul>

      <div class="about__cta">
        <Button href="/sobre" variant="text">Trajetória e formação completas</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-paper);
  }
  .about__grid {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }
  .about__figure {
    margin: 0;
  }
  .about__frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #2a2b2e;
  }
  .about__frame :global(img),
  .about__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .about__oab {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-gold-ink);
  }

  .about__role {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }
  /* Os 20 anos como frase tipográfica, não como "número grande + rótulo" */
  .about__statement {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-gold);
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.2;
    max-width: 22ch;
  }
  .about__text {
    margin-top: 1rem;
    max-width: 36rem;
    color: var(--color-muted);
  }
  .about__edu-title {
    margin-top: 2.5rem;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
  }
  .about__edu {
    margin-top: 0.75rem;
    border-top: 1px solid rgb(15 30 51 / 0.12);
  }
  .about__edu li {
    padding-block: 0.75rem;
    border-bottom: 1px solid rgb(15 30 51 / 0.12);
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }
  .about__cta {
    margin-top: 1.25rem;
  }
</style>
