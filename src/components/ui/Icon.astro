---
/** Ícones de traço fino, desenhados para o projeto. Sempre decorativos (aria-hidden). */
interface Props {
  name: 'arrow' | 'arrow-up-right' | 'whatsapp' | 'plus' | 'instagram' | 'menu' | 'close';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'menu' && <path d="M3 8h18M3 16h18" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="3.8" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <path d="M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3.5 20.5l1.4-4.3A8.5 8.5 0 1 1 20.5 11.6ZM9 8.3c.2-.4.5-.4.8-.4h.5c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .5-.1.6l-.5.6c-.1.2-.2.3 0 .6.6 1 1.5 1.8 2.6 2.3.3.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .5-.2 1.1-.6 1.4-.5.4-1.2.6-1.9.4-1.4-.4-2.8-1.2-3.9-2.3-1-1-1.8-2.2-2.2-3.4-.2-.8 0-1.6.5-2.2Z" />
    )
  }
</svg>
