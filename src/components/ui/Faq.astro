---
/** FAQ com <details> nativo: acessível por teclado e indexável sem JS. */
import Icon from './Icon.astro';
import type { FaqItem } from '@/data/areas';

interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f, i) => (
      <details class="faq__item" open={i === 0}>
        <summary class="faq__q">
          <span>{f.q}</span>
          <span class="faq__icon" aria-hidden="true">
            <Icon name="plus" size={20} />
          </span>
        </summary>
        <div class="faq__a">
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid rgb(var(--ink-rgb) / 0.14);
  }
  .faq__item {
    border-bottom: 1px solid rgb(var(--ink-rgb) / 0.14);
  }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    line-height: 1.3;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(var(--ink-rgb) / 0.16);
    transition: transform 0.3s var(--ease-out-quint), background-color var(--dur-hover), color var(--dur-hover);
  }
  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--color-navy-900);
    color: var(--color-gold-soft);
    box-shadow: none;
  }
  .faq__q:hover .faq__icon {
    box-shadow: inset 0 0 0 1px var(--color-gold);
  }
  .faq__a {
    padding-bottom: 1.6rem;
    max-width: 46rem;
    color: var(--color-muted);
  }
  /* Abertura suave onde houver suporte */
  @supports (interpolate-size: allow-keywords) {
    .faq__item {
      interpolate-size: allow-keywords;
    }
    .faq__item::details-content {
      height: 0;
      overflow: clip;
      transition: height 0.35s var(--ease-out-quint), content-visibility 0.35s allow-discrete;
    }
    .faq__item[open]::details-content {
      height: auto;
    }
  }
</style>
