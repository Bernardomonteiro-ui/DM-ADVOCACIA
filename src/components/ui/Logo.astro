---
/**
 * Logo oficial da DM Advocacia (arquivo do cliente: materiais/logo-dm-advocacia.jpeg).
 * Os recortes com fundo transparente são gerados por `npm run images`.
 *
 * - horizontal: monograma + letreiro lado a lado (header) — no formato quadrado original,
 *   "LEX ET ORDO" ficaria ilegível na altura do header.
 * - completo: logo original empilhado (rodapé).
 */
import { Image } from 'astro:assets';
import monograma from '@/assets/logo/logo-monograma.png';
import letreiro from '@/assets/logo/logo-letreiro.png';
import completo from '@/assets/logo/logo-completo.png';

interface Props {
  variant?: 'horizontal' | 'completo';
  class?: string;
  eager?: boolean;
}
const { variant = 'horizontal', class: className = '', eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

{
  variant === 'horizontal' ? (
    <span class:list={['logo', className]}>
      <Image src={monograma} alt="" width={58} densities={[1, 2]} format="webp" loading={loading} class="logo__mark" />
      <Image src={letreiro} alt="" width={120} densities={[1, 2]} format="webp" loading={loading} class="logo__word" />
      <span class="sr-only">DM Advocacia, Lex et Ordo</span>
    </span>
  ) : (
    <span class:list={['logo-full', className]}>
      <Image src={completo} alt="DM Advocacia, Lex et Ordo" width={150} densities={[1, 2]} format="webp" loading={loading} />
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .logo :global(img) {
    display: block;
    width: auto;
    transition: height 0.4s var(--ease-out-quint);
  }
  .logo__mark {
    height: 2.9rem;
  }
  .logo__word {
    height: 1.7rem;
  }
  .logo-full :global(img) {
    display: block;
    width: 9.5rem;
    height: auto;
  }
</style>
